# Copy to .env and fill in. Nothing here is optional once its phase is active.

# Local Postgres from docker-compose.yml (Phase 0)
DATABASE_URL="postgresql://aynat:aynat@localhost:5432/aynat"

# Auth.js (Phase 0) — generate secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth client (Phase 0 for sign-in; same client gains the
# gmail.readonly scope via incremental consent in Phase 4).
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic Messages API (Phase 2+)
ANTHROPIC_API_KEY=""
EXTRACTION_MODEL="claude-sonnet-5"

# File storage adapter root in dev (Phase 2+); S3 vars reserved for later
STORAGE_DIR="./storage"

# Extraction backend: "agent" = local Claude Code CLI (subscription, no key),
# "stub" = canned results (no auth), "api" = Messages API (needs ANTHROPIC_API_KEY)
EXTRACTION_BACKEND="agent"

# Gmail auto-add (Settings → Gmail, off by default): minimum extraction
# confidence for an email item to skip review. Raise toward 1.0 for stricter.
AUTO_ACCEPT_MIN_CONFIDENCE="0.9"
