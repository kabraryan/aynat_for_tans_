generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DONE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  timezone      String    @default("Asia/Kolkata") // IANA render timezone; storage is UTC
  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  tasks         Task[]
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  notes       String?
  dueAt       DateTime? // UTC
  allDayDue   Boolean    @default(false)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  sortOrder   Int        @default(0)
  sourceId    String? // provenance; only proposal acceptance sets this (Phase 2)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
  @@index([userId, courseId])
}

model Course {
  id     String  @id @default(cuid())
  userId String
  name   String
  code   String?
  color  String // hex, from the curated palette in src/lib/colors.ts
  term   String? // plain string — no Term entity in v1
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId])
}

// Auth.js standard models. Account also holds the Google refresh/access
// tokens the Gmail sync (Phase 4) depends on — hence database sessions.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
